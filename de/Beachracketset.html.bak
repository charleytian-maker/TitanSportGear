<style type="text/css">
/* Auch das Dropdown-Menü auf der Beach-Paddle-Set-Seite bekommt eine Scrollleiste */

/* Äußerer Container für die Bildergalerie */
.Beachracketset-container {
    background-color: #1a1a1a;  /* Dunkles, hochwertiges Erscheinungsbild unterhalb des Headers beibehalten */
    padding: 60px 20px;         /* Angenehmer Innenabstand oben/unten/links/rechts */
}

.Beachracketset-gallery {
    max-width: 1200px;          /* Maximale Breite begrenzen, damit Bilder auf großen Bildschirmen nicht zu weit auseinanderstehen */
    margin: 0 auto;             /* Zentriert anzeigen */
    display: grid;              /* Modernes Grid-Layout aktivieren */
    grid-template-columns: repeat(5, 1fr); /* Kernpunkt: genau 5 Bilder pro Reihe */
    gap: 20px;                  /* Abstand zwischen den Bildern */
}

/* Stil für jedes einzelne Bild */
.Beachracketset-gallery img {
    width: 100%;                /* Breite füllt das Grid automatisch aus */
    height: 220px;              /* Feste Höhe, damit alle Bilder gleich groß sind */
    object-fit: contain;          /* Bild automatisch einpassen, ohne Verzerrung */
    background-color: #fff;
    border-radius: 6px;         /* Leicht abgerundete Ecken für ein schöneres Erscheinungsbild */
    box-shadow: 0 4px 10px rgba(0,0,0,0.5); /* Leichter Schlagschatten für mehr Tiefe */
    transition: transform 0.3s; /* Sanfte Animation beim Überfahren mit der Maus */
}

/* Leichter Hover-Effekt beim Überfahren mit der Maus */
.Beachracketset-gallery img:hover {
    transform: translateY(-5px); /* Bild hebt sich leicht an */
}
</style>
