<style type="text/css">
/* 本页下拉菜单高度覆盖（比默认 350px 矮，产品分类更少） */

/* 图片画廊容器 */
.basketball-container {
    background-color: #1a1a1a;
    padding: 60px 20px;
    margin-top:80px;
}
.basketball-gallery {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
}
.basketball-gallery img {
    width: 100%;                /* 宽度自动撑满网格 */
    height: 220px;              /* 固定高度，确保每张图大小完全一致 */
    object-fit: contain;          /* 图片自动裁剪填充，不会变形拉伸 */
    background-color: #fff;
    border-radius: 6px;         /* 微微的圆角，更美观 */
    box-shadow: 0 4px 10px rgba(0,0,0,0.5); /* 给图片加一点立体阴影 */
    transition: transform 0.3s; /* 鼠标放上去时加上平滑动画 */
}
.basketball-gallery img:hover {
    transform: translateY(-5px);
}
</style>
